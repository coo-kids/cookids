{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@cookids/domain/*": [
        "./packages/domain/*"
      ],
      "@cookids/infrastructure/*": [
        "./packages/infrastructure/*"
      ],
      "@cookids/server/*": [
        "./packages/server/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "packages/**/*.ts",
    "api/**/*.ts",
    "packages/server/**/*.ts",
    "packages/web/src/**/*.ts",
    "packages/web/src/**/*.vue",
    "**/vite.config.ts",
    "**/vitest.config.ts"
  ],
  "exclude": [
    "packages/*/node_modules"
  ]
}
