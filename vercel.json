{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bunx bun@1.4.0 install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
