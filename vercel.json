{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "./packages/web/dist",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/guestbook.ts": {
      "includeFiles": "contents/*.yml"
    },
    "api/orders.ts": {
      "includeFiles": "contents/*.yml"
    }
  }
}
