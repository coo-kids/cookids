{
  "name": "cookids",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "vue-tsc --project ./tsconfig.json --noEmit",
    "build": "bun run --cwd apps/web build",
    "dev": "bun run --cwd apps/web dev",
    "test": "bun test"
  },
  "dependencies": {
    "@cookids/domain": "workspace:*",
    "@cookids/infrastructure": "workspace:*",
    "@tsed/di": "^8.38.4",
    "@tsed/ajv": "^8.38.4",
    "@tsed/exceptions": "^8.38.4",
    "@tsed/schema": "^8.38.4",
    "@tsed/json-mapper": "^8.38.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vercel/node": "^12.0.2",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
