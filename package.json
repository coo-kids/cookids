{
  "name": "cookids",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "vue-tsc --project ./tsconfig.json --noEmit",
    "build": "bun run --cwd packages/web build",
    "dev": "bun run --cwd packages/web dev",
    "start": "bun run packages/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cookids/domain": "workspace:*",
    "@cookids/infrastructure": "workspace:*",
    "@tsed/di": "^8.38.4",
    "@tsed/ajv": "^8.38.4",
    "@tsed/exceptions": "^8.38.4",
    "@tsed/schema": "^8.38.4",
    "@tsed/json-mapper": "^8.38.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "bun": "1.4.x"
  }
}
