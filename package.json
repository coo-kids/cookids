{
  "name": "cookids",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "api:build": "tsc --project tsconfig.api.json --noEmit",
    "build": "bun run api:build && bun run --cwd apps/web build",
    "dev": "bun run --cwd apps/web dev",
    "test": "bun test"
  },
  "dependencies": {
    "@cookids/domain": "workspace:*",
    "@cookids/infrastructure": "workspace:*",
    "@tsed/di": "^8.38.4",
    "@tsed/json-mapper": "^8.38.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vercel/node": "^5.3.0",
    "typescript": "^5.8.0"
  }
}
